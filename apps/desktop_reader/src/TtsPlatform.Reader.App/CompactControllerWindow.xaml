<Window x:Class="TtsPlatform.Reader.App.CompactControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTS Platform Reader Controls" Width="520" Height="105"
        MinWidth="420" MinHeight="95" MaxHeight="150"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        AutomationProperties.Name="Compact Reader controller">
  <Border Background="#F7F7F7" BorderBrush="#AAA" BorderThickness="1" Padding="10">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPause_Click"
              AutomationProperties.Name="Play or pause" />
      <Button Grid.Column="1" Content="Stop" Click="Stop_Click"
              AutomationProperties.Name="Stop playback" />
      <StackPanel Grid.Column="2" Margin="10,0">
        <TextBlock x:Name="ContextText" Text="No active document" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StateText" Text="Stopped" Foreground="#555" />
      </StackPanel>
      <Button Grid.Column="3" Content="Open Reader" Click="OpenReader_Click"
              AutomationProperties.Name="Open main Reader window" />
    </Grid>
  </Border>
</Window>
