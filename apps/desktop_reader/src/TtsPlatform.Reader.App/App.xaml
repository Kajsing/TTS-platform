<Application x:Class="TtsPlatform.Reader.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#23777A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1B6467" />
    <SolidColorBrush x:Key="NavigationBrush" Color="#18324A" />
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#24455F" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE5" />
    <SolidColorBrush x:Key="TextBrush" Color="#17212B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#65717D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#A33A3A" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#FFE3A3" />

    <Geometry x:Key="SpeakerGeometry">M2,7 L5,7 L9,3 L9,17 L5,13 L2,13 Z M12,7 C14,9 14,11 12,13 M15,4 C19,8 19,12 15,16</Geometry>
    <Geometry x:Key="PlayGeometry">M3,2 L15,9 L3,16 Z</Geometry>
    <Geometry x:Key="PauseGeometry">M3,2 H7 V16 H3 Z M11,2 H15 V16 H11 Z</Geometry>
    <Geometry x:Key="StopGeometry">M3,3 H15 V15 H3 Z</Geometry>
    <Geometry x:Key="CursorGeometry">M2,1 L2,16 L6.5,11.5 L10,18 L13,16.5 L9.5,10 H16 Z</Geometry>
    <Geometry x:Key="PreviousGeometry">M3,3 H5 V15 H3 Z M15,3 L7,9 L15,15 Z</Geometry>
    <Geometry x:Key="NextGeometry">M13,3 H15 V15 H13 Z M3,3 L11,9 L3,15 Z</Geometry>
    <Geometry x:Key="PlusGeometry">M8,2 H10 V8 H16 V10 H10 V16 H8 V10 H2 V8 H8 Z</Geometry>
    <Geometry x:Key="SearchGeometry">M8,2 A6,6 0 1 1 7.9,14 A6,6 0 0 1 8,2 M12.5,12.5 L17,17</Geometry>

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F4F6" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#AEBAC4" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#E4EAEE" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#527089" />
      <Setter Property="Padding" Value="10,5" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource NavigationHoverBrush}" />
          <Setter Property="BorderBrush" Value="#7690A5" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="#E4C5C5" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="3" />
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E8ECEF" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="RowHeight" Value="42" />
      <Setter Property="ColumnHeaderHeight" Value="38" />
      <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
    </Style>
  </Application.Resources>
</Application>
