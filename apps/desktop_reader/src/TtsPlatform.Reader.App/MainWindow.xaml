<Window x:Class="TtsPlatform.Reader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TtsPlatform.Reader.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TTS Platform Reader" Height="800" Width="1240" MinHeight="620" MinWidth="920"
        Icon="Assets/TtsPlatformReader.ico"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_PreviewKeyDown"
        AllowDrop="True" DragOver="MainWindow_DragOver" Drop="MainWindow_Drop">
  <Window.Resources>
    <DataTemplate x:Key="ReadingBlockTemplate">
      <local:SourceHighlightTextBlock SourceText="{Binding Text}"
          HighlightStart="{Binding HighlightStart}"
          HighlightLength="{Binding HighlightLength}"
          TextWrapping="Wrap" FontFamily="{Binding DisplayFontFamily}"
          FontSize="{Binding DisplayFontSize}" FontWeight="{Binding DisplayFontWeight}"
          FontStyle="{Binding DisplayFontStyle}" Margin="{Binding DisplayMargin}" />
    </DataTemplate>
    <Style x:Key="InvisibleReadingBlockContainerStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource NavigationBrush}" Padding="18,11">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="{StaticResource SpeakerGeometry}" Width="25" Height="25" Stretch="Uniform"
                Stroke="White" StrokeThickness="1.5" Fill="White" Margin="0,0,11,0" />
          <StackPanel>
            <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold"
                       Text="TTS Platform Reader" />
            <TextBlock Foreground="#AFC3D3" FontSize="11" Text="Your local reading workspace" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ServiceStatusDot" Width="9" Height="9" Fill="#E0A52B" Margin="0,0,7,0" />
          <TextBlock x:Name="ServiceStatusText" Foreground="White" Margin="0,4,12,0"
                     Text="Service: checking" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="StartServiceButton" Content="Start service" Style="{StaticResource HeaderButtonStyle}"
                  Click="StartServiceButton_Click" IsEnabled="False"
                  AutomationProperties.Name="Start local TTS service" />
          <Button x:Name="StopServiceButton" Content="Stop service" Style="{StaticResource HeaderButtonStyle}"
                  Click="StopServiceButton_Click" IsEnabled="False"
                  AutomationProperties.Name="Stop local TTS service" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" x:Name="StatusBorder" Style="{StaticResource CardStyle}" Margin="16,10,16,0"
            Padding="12" Background="#FFF8E8">
      <StackPanel>
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="ReadClipboardButton" Content="Read clipboard" Click="ReadClipboardButton_Click"
                    AutomationProperties.Name="Read clipboard without saving" />
            <Button x:Name="CompactButton" Content="Compact player" Click="CompactButton_Click"
                    AutomationProperties.Name="Open compact playback controller" />
            <Button x:Name="SpeechRulesButton" Content="Speech rules…" Click="SpeechRulesButton_Click"
                    AutomationProperties.Name="Manage speech rules" />
            <Button x:Name="RefreshButton" Content="Check connection" Click="RefreshButton_Click"
                    AutomationProperties.Name="Check local service connection" />
            <Button x:Name="ActionButton" Content="Connection help" Click="ActionButton_Click"
                    AutomationProperties.Name="Run suggested connection action" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Connection has not been checked." FontWeight="SemiBold"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="ClipboardStatusText" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,8,0"
                       Text="Clipboard prompt: Off" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </DockPanel>
        <Expander Header="Connection and keyboard settings" Margin="0,7,0,0">
          <StackPanel Margin="0,5,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Service URL" VerticalAlignment="Center" Margin="0,0,5,0" />
              <TextBox Grid.Column="1" x:Name="ServiceUrlTextBox" AutomationProperties.Name="Service URL" />
              <TextBlock Grid.Column="2" Text="Token file" VerticalAlignment="Center" Margin="12,0,5,0" />
              <TextBox Grid.Column="3" x:Name="TokenPathTextBox" AutomationProperties.Name="Token file path" />
              <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Content="Browse…" Click="BrowseTokenButton_Click" />
                <Button Content="Save" Click="SaveSettingsButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Voice" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" x:Name="VoiceComboBox" Width="300"
                        DisplayMemberPath="DisplayName" IsEnabled="False"
                        SelectionChanged="VoiceComboBox_SelectionChanged"
                        ToolTip="Used for the next playback and new exports. Choose Save to keep it for the next launch."
                        AutomationProperties.Name="Reading voice" />
              <TextBlock Grid.Column="2" x:Name="VoiceDetailsText" Margin="12,0,0,0"
                         VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                         Text="Connect to load installed voices." TextWrapping="Wrap" />
            </Grid>
            <WrapPanel Margin="0,7,0,0">
              <CheckBox x:Name="ClipboardMonitoringCheckBox" Content="Clipboard prompt mode"
                        Click="ClipboardMonitoringCheckBox_Click" Margin="4" />
              <CheckBox x:Name="CopySelectionCheckBox" Content="Enable Copy Selection and Read" Margin="4" />
              <CheckBox x:Name="PrivacyModeCheckBox" Content="Privacy mode" Margin="4" />
              <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to tray on close" Margin="4" />
              <CheckBox x:Name="CompactEnabledCheckBox" Content="Remember compact controller" Margin="4" />
            </WrapPanel>
            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Blocked apps" VerticalAlignment="Center" Margin="0,0,5,0" />
              <TextBox Grid.Column="1" x:Name="BlockedApplicationsTextBox"
                       ToolTip="Comma-separated executable names" />
              <TextBlock Grid.Column="2" Text="Read" VerticalAlignment="Center" Margin="8,0,4,0" />
              <TextBox Grid.Column="3" x:Name="ReadClipboardHotkeyTextBox" Width="95" />
              <TextBlock Grid.Column="4" Text="Selection" VerticalAlignment="Center" Margin="8,0,4,0" />
              <TextBox Grid.Column="5" x:Name="CopySelectionHotkeyTextBox" Width="95" />
              <TextBlock Grid.Column="6" Text="Play/Pause" VerticalAlignment="Center" Margin="8,0,4,0" />
              <TextBox Grid.Column="7" x:Name="PlayPauseHotkeyTextBox" Width="85" />
              <TextBlock Grid.Column="8" Text="Stop" VerticalAlignment="Center" Margin="8,0,4,0" />
              <TextBox Grid.Column="9" x:Name="StopHotkeyTextBox" Width="85" />
            </Grid>
            <TextBlock x:Name="HotkeyStatusText" Margin="3,5,0,0" Foreground="{StaticResource TextMutedBrush}"
                       Text="Global hotkeys are not registered yet." TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="16,12,16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" MinWidth="310" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" MinWidth="500" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="15,13,12,8">
            <Button DockPanel.Dock="Right" x:Name="ImportButton" Click="ImportButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Import document file">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource PlusGeometry}" Width="14" Height="14" Stretch="Uniform"
                      Fill="White" Margin="0,0,6,0" />
                <TextBlock Text="Import" />
              </StackPanel>
            </Button>
            <TextBlock Text="Library" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <Grid Grid.Row="1" Margin="10,0,10,9">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="112" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox" AutomationProperties.Name="Search library"
                     ToolTip="Search document titles and content" />
            <ComboBox Grid.Column="1" x:Name="LibraryStateComboBox"
                      SelectedIndex="0" SelectionChanged="LibraryStateComboBox_SelectionChanged"
                      AutomationProperties.Name="Library state filter">
              <ComboBoxItem Content="All" Tag="" />
              <ComboBoxItem Content="Inbox" Tag="inbox" />
              <ComboBoxItem Content="Reading" Tag="active" />
              <ComboBoxItem Content="Finished" Tag="finished" />
              <ComboBoxItem Content="Archive" Tag="archived" />
            </ComboBox>
            <Button Grid.Column="2" Click="SearchButton_Click" ToolTip="Search">
              <Path Data="{StaticResource SearchGeometry}" Width="16" Height="16"
                    Stretch="Uniform" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" />
            </Button>
          </Grid>
          <DataGrid Grid.Row="2" x:Name="DocumentsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    BorderThickness="0,1,0,1" SelectionMode="Single"
                    SelectionChanged="DocumentsGrid_SelectionChanged"
                    EnableRowVirtualization="True" AutomationProperties.Name="Reader library">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
              <DataGridTextColumn Header="State" Binding="{Binding State}" Width="82" />
            </DataGrid.Columns>
          </DataGrid>
          <Button Grid.Row="3" x:Name="LoadMoreButton" Content="Load more" Click="LoadMoreButton_Click"
                  HorizontalAlignment="Left" IsEnabled="False" Margin="12,8" />
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" />

      <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Margin="19,15,16,10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RenameDocumentButton" Content="Rename"
                        Click="RenameDocumentButton_Click" IsEnabled="False"
                        AutomationProperties.Name="Rename selected document" />
                <Button x:Name="DeleteDocumentButton" Content="Delete…"
                        Click="DeleteDocumentButton_Click" IsEnabled="False"
                        Style="{StaticResource DangerButtonStyle}"
                        AutomationProperties.Name="Delete selected article" />
              </StackPanel>
              <TextBlock x:Name="DocumentTitleText" Text="Select a document" FontSize="24"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="EditorHintText" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                       Text="Choose an article from the library." TextWrapping="Wrap" />
          </StackPanel>

          <Grid Grid.Row="1" Margin="16,0,16,10">
            <AdornerDecorator x:Name="EditorAdornerDecorator" Visibility="Collapsed">
              <TextBox x:Name="EditorTextBox" AcceptsReturn="True" AcceptsTab="True"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                       TextWrapping="Wrap" IsReadOnly="True" FontFamily="Segoe UI" FontSize="18"
                       TextBlock.LineHeight="27" Padding="18" BorderThickness="1"
                       BorderBrush="{StaticResource BorderBrush}"
                       IsInactiveSelectionHighlightEnabled="True"
                       SelectionBrush="{StaticResource HighlightBrush}"
                       SelectionTextBrush="{StaticResource TextBrush}" SelectionOpacity="0.32"
                       SelectionChanged="EditorTextBox_SelectionChanged"
                       TextChanged="EditorTextBox_TextChanged"
                       AutomationProperties.Name="Continuous document text" />
            </AdornerDecorator>
            <ListBox x:Name="ReadingBlocksList" Visibility="Collapsed" BorderThickness="1"
                     BorderBrush="{StaticResource BorderBrush}" Padding="18"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionMode="Single" SelectionChanged="ReadingBlocksList_SelectionChanged"
                     ItemTemplate="{StaticResource ReadingBlockTemplate}"
                     ItemContainerStyle="{StaticResource InvisibleReadingBlockContainerStyle}"
                     AutomationProperties.Name="Document text" />
          </Grid>

          <Border Grid.Row="2" Margin="16,0,16,10" Padding="12,9"
                  Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="ReadingRangeText" Foreground="{StaticResource TextMutedBrush}"
                           Text="No article selected" Margin="10,3,2,0" />
                <TextBlock x:Name="PlaybackStatusText" Text="Stopped" FontWeight="SemiBold" Margin="3,3,0,0"
                           AutomationProperties.LiveSetting="Polite" />
              </DockPanel>
              <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button x:Name="PreviousSectionButton" Click="PreviousSectionButton_Click"
                        IsEnabled="False" Visibility="Collapsed"
                        AutomationProperties.Name="Go to previous section" ToolTip="Previous section">
                  <Path Data="{StaticResource PreviousGeometry}" Width="15" Height="15" Stretch="Uniform"
                        Fill="{StaticResource TextBrush}" />
                </Button>
                <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                        AutomationProperties.Name="Play or pause document"
                        ToolTip="Resumes after Pause. After Stop, starts at the beginning.">
                  <StackPanel Orientation="Horizontal">
                    <Path x:Name="PlayPauseIcon" Data="{StaticResource PlayGeometry}" Width="16" Height="16"
                          Stretch="Uniform" Fill="White" Margin="0,0,7,0" />
                    <TextBlock x:Name="PlayPauseLabel" Text="Play" />
                  </StackPanel>
                </Button>
                <Button x:Name="StopButton" Click="StopButton_Click" IsEnabled="False"
                        AutomationProperties.Name="Stop document playback"
                        ToolTip="Stops playback and resets the next Play to the beginning.">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource StopGeometry}" Width="14" Height="14" Stretch="Uniform"
                          Fill="{StaticResource TextBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="Stop" />
                  </StackPanel>
                </Button>
                <Button x:Name="NextSectionButton" Click="NextSectionButton_Click"
                        IsEnabled="False" Visibility="Collapsed"
                        AutomationProperties.Name="Go to next section" ToolTip="Next section">
                  <Path Data="{StaticResource NextGeometry}" Width="15" Height="15" Stretch="Uniform"
                        Fill="{StaticResource TextBrush}" />
                </Button>
                <Button x:Name="PlayFromCursorButton" Click="PlayFromCursorButton_Click" IsEnabled="False"
                        AutomationProperties.Name="Start document playback at text cursor"
                        ToolTip="Starts at the current text cursor instead of the saved playback position.">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CursorGeometry}" Width="15" Height="16" Stretch="Uniform"
                          Fill="{StaticResource TextBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="Start at cursor" />
                  </StackPanel>
                </Button>
                <CheckBox x:Name="AutoAdvanceCheckBox" Content="Auto-advance queue"
                          VerticalAlignment="Center" Margin="9,0,4,0" />
              </WrapPanel>
            </Grid>
          </Border>

          <Expander Grid.Row="3" Header="Article tools" Margin="16,0,16,12">
            <WrapPanel Margin="0,5,0,0">
              <Button x:Name="PreviousReadingPageButton" Content="Previous page"
                      Click="PreviousReadingPageButton_Click" IsEnabled="False" />
              <Button x:Name="NextReadingPageButton" Content="Next page"
                      Click="NextReadingPageButton_Click" IsEnabled="False" />
              <CheckBox x:Name="FollowReadingCheckBox" Content="Follow reading" IsChecked="True"
                        VerticalAlignment="Center" Margin="6,0" />
              <Button x:Name="DuplicateEditableButton" Content="Create editable copy"
                      Click="DuplicateEditableButton_Click" IsEnabled="False" />
              <Button x:Name="CreateRuleFromSelectionButton" Content="Create rule from selection"
                      Click="CreateRuleFromSelectionButton_Click"
                      AutomationProperties.Name="Create speech rule from selected text" />
              <Button x:Name="LibraryWorkflowButton" Content="Queue / bookmarks / audio"
                      Click="LibraryWorkflowButton_Click" />
              <Button x:Name="FinishDocumentButton" Content="Mark finished"
                      Click="FinishDocumentButton_Click" IsEnabled="False" />
              <Button x:Name="ArchiveDocumentButton" Content="Archive"
                      Click="ArchiveDocumentButton_Click" IsEnabled="False" />
              <Button x:Name="RestoreDocumentButton" Content="Restore to inbox"
                      Click="RestoreDocumentButton_Click" IsEnabled="False" />
              <Button x:Name="SaveEditButton" Content="Save changes" Click="SaveEditButton_Click"
                      IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" />
              <Button x:Name="RevertEditButton" Content="Revert changes" Click="RevertEditButton_Click" IsEnabled="False" />
              <Button x:Name="UndoButton" Content="Undo" Click="UndoButton_Click" IsEnabled="False" />
              <Button x:Name="RedoButton" Content="Redo" Click="RedoButton_Click" IsEnabled="False" />
            </WrapPanel>
          </Expander>
        </Grid>
      </Border>
    </Grid>

    <StatusBar Grid.Row="3" Background="{StaticResource NavigationBrush}" Foreground="White" Padding="8,2">
      <StatusBarItem Foreground="White"><TextBlock x:Name="FooterText" Text="Ready" /></StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
