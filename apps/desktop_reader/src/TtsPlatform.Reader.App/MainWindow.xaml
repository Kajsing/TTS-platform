<Window x:Class="TtsPlatform.Reader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TtsPlatform.Reader.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TTS Platform Reader" Height="760" Width="1180" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_PreviewKeyDown"
        AllowDrop="True" DragOver="MainWindow_DragOver" Drop="MainWindow_Drop">
  <Window.Resources>
    <DataTemplate x:Key="ReadingBlockTemplate">
      <local:SourceHighlightTextBlock SourceText="{Binding Text}"
          HighlightStart="{Binding HighlightStart}"
          HighlightLength="{Binding HighlightLength}"
          TextWrapping="Wrap" FontFamily="{Binding DisplayFontFamily}"
          FontSize="{Binding DisplayFontSize}" FontWeight="{Binding DisplayFontWeight}"
          FontStyle="{Binding DisplayFontStyle}" Margin="{Binding DisplayMargin}" />
    </DataTemplate>
    <DataTemplate x:Key="EditableBlockTemplate">
      <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
               BorderThickness="1" BorderBrush="Transparent" Background="Transparent"
               FontFamily="{Binding DisplayFontFamily}" FontSize="{Binding DisplayFontSize}"
               FontWeight="{Binding DisplayFontWeight}" FontStyle="{Binding DisplayFontStyle}"
               Margin="{Binding DisplayMargin}" Padding="3"
               GotKeyboardFocus="InlineEditor_GotKeyboardFocus"
               SelectionChanged="InlineEditor_SelectionChanged"
               TextChanged="InlineEditor_TextChanged"
               AutomationProperties.Name="Editable document text" />
    </DataTemplate>
  </Window.Resources>
  <Grid Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="16,12">
      <DockPanel LastChildFill="True">
        <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold"
                   Text="TTS Platform Reader" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock x:Name="ServiceStatusText" Foreground="White" Margin="0,5,10,0"
                     Text="Service: checking" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="StartServiceButton" Content="Start service"
                  Click="StartServiceButton_Click" IsEnabled="False"
                  AutomationProperties.Name="Start local TTS service" />
          <Button x:Name="StopServiceButton" Content="Stop service"
                  Click="StopServiceButton_Click" IsEnabled="False"
                  AutomationProperties.Name="Stop local TTS service" />
          <TextBlock x:Name="ClipboardStatusText" Foreground="White" Margin="0,5,10,0"
                     Text="Clipboard prompt: Off" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="ReadClipboardButton" Content="Read Clipboard" Click="ReadClipboardButton_Click"
                  AutomationProperties.Name="Read clipboard without saving" />
          <Button x:Name="CompactButton" Content="Compact" Click="CompactButton_Click"
                  AutomationProperties.Name="Open compact playback controller" />
          <Button x:Name="SpeechRulesButton" Content="Speech rules…" Click="SpeechRulesButton_Click"
                  AutomationProperties.Name="Manage speech rules" />
          <Button x:Name="RefreshButton" Content="Check connection" Click="RefreshButton_Click"
                  AutomationProperties.Name="Check local service connection" />
          <Button x:Name="ActionButton" Content="Connection help" Click="ActionButton_Click"
                  AutomationProperties.Name="Run suggested connection action" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" x:Name="StatusBorder" Background="#FFF4D6" Padding="12">
      <StackPanel>
        <TextBlock x:Name="StatusText" Text="Connection has not been checked." FontWeight="SemiBold"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Expander Header="Connection settings" Margin="0,8,0,0">
          <StackPanel Margin="0,4,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Service URL" VerticalAlignment="Center" Margin="0,0,5,0" />
              <TextBox Grid.Column="1" x:Name="ServiceUrlTextBox" AutomationProperties.Name="Service URL" />
              <TextBlock Grid.Column="2" Text="Token file" VerticalAlignment="Center" Margin="12,0,5,0" />
              <TextBox Grid.Column="3" x:Name="TokenPathTextBox" AutomationProperties.Name="Token file path" />
              <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Content="Browse…" Click="BrowseTokenButton_Click" />
                <Button Content="Save" Click="SaveSettingsButton_Click" />
              </StackPanel>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
              <CheckBox x:Name="ClipboardMonitoringCheckBox" Content="Clipboard prompt mode"
                        Click="ClipboardMonitoringCheckBox_Click" />
              <CheckBox x:Name="CopySelectionCheckBox" Content="Enable Copy Selection and Read" />
              <CheckBox x:Name="PrivacyModeCheckBox" Content="Privacy mode" />
              <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to tray on close" />
              <CheckBox x:Name="CompactEnabledCheckBox" Content="Remember compact controller" />
            </WrapPanel>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Blocked apps" VerticalAlignment="Center" Margin="0,0,5,0" />
              <TextBox Grid.Column="1" x:Name="BlockedApplicationsTextBox"
                       ToolTip="Comma-separated executable names" />
              <TextBlock Grid.Column="2" Text="Read" VerticalAlignment="Center" Margin="8,0,4,0" />
              <TextBox Grid.Column="3" x:Name="ReadClipboardHotkeyTextBox" Width="95" />
              <TextBlock Grid.Column="4" Text="Selection" VerticalAlignment="Center" Margin="8,0,4,0" />
              <TextBox Grid.Column="5" x:Name="CopySelectionHotkeyTextBox" Width="95" />
              <TextBlock Grid.Column="6" Text="Play/Pause" VerticalAlignment="Center" Margin="8,0,4,0" />
              <TextBox Grid.Column="7" x:Name="PlayPauseHotkeyTextBox" Width="85" />
              <TextBlock Grid.Column="8" Text="Stop" VerticalAlignment="Center" Margin="8,0,4,0" />
              <TextBox Grid.Column="9" x:Name="StopHotkeyTextBox" Width="85" />
            </Grid>
            <TextBlock x:Name="HotkeyStatusText" Margin="0,6,0,0" Foreground="#555"
                       Text="Global hotkeys are not registered yet." TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="300" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="3*" MinWidth="380" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="Search" Click="SearchButton_Click" />
          <Button DockPanel.Dock="Right" x:Name="ImportButton" Content="Import..."
                  Click="ImportButton_Click" AutomationProperties.Name="Import document file" />
          <ComboBox DockPanel.Dock="Right" x:Name="LibraryStateComboBox" Width="105"
                    SelectedIndex="0" SelectionChanged="LibraryStateComboBox_SelectionChanged"
                    AutomationProperties.Name="Library state filter">
            <ComboBoxItem Content="All" Tag="" />
            <ComboBoxItem Content="Inbox" Tag="inbox" />
            <ComboBoxItem Content="Reading" Tag="active" />
            <ComboBoxItem Content="Finished" Tag="finished" />
            <ComboBoxItem Content="Archive" Tag="archived" />
          </ComboBox>
          <TextBox x:Name="SearchTextBox" AutomationProperties.Name="Search library"
                   ToolTip="Search document titles and content" />
        </DockPanel>
        <DataGrid Grid.Row="1" x:Name="DocumentsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="DocumentsGrid_SelectionChanged"
                  EnableRowVirtualization="True" AutomationProperties.Name="Reader library">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
            <DataGridTextColumn Header="Source" Binding="{Binding SourceType}" Width="110" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="2" x:Name="LoadMoreButton" Content="Load more" Click="LoadMoreButton_Click"
                HorizontalAlignment="Left" IsEnabled="False" />
      </Grid>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="RenameDocumentButton" Content="Rename"
                    Click="RenameDocumentButton_Click" IsEnabled="False"
                    AutomationProperties.Name="Rename selected document" />
            <TextBlock x:Name="DocumentTitleText" Text="Select a document" FontSize="20"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <TextBlock x:Name="EditorHintText" Foreground="#555" Margin="0,3,0,8"
                     Text="Editable text will appear here." TextWrapping="Wrap" />
          <WrapPanel Margin="0,0,0,8">
            <Button x:Name="PreviousSectionButton" Content="Previous section" Click="PreviousSectionButton_Click"
                    IsEnabled="False" AutomationProperties.Name="Go to previous section" />
            <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPauseButton_Click"
                    IsEnabled="False" AutomationProperties.Name="Play or pause document" />
            <Button x:Name="PlayFromCursorButton" Content="Play from cursor"
                    Click="PlayFromCursorButton_Click" IsEnabled="False"
                    AutomationProperties.Name="Start playback from text cursor" />
            <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click"
                    IsEnabled="False" AutomationProperties.Name="Stop document playback" />
            <Button x:Name="NextSectionButton" Content="Next section" Click="NextSectionButton_Click"
                    IsEnabled="False" AutomationProperties.Name="Go to next section" />
            <CheckBox x:Name="AutoAdvanceCheckBox" Content="Auto-advance queue"
                      VerticalAlignment="Center" Margin="8,0" />
            <TextBlock x:Name="PlaybackStatusText" Text="Stopped" Margin="10,5,0,0"
                       AutomationProperties.LiveSetting="Polite" />
          </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
          <TextBox x:Name="EditorTextBox" AcceptsReturn="True" AcceptsTab="True" Visibility="Collapsed"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   TextWrapping="Wrap" IsReadOnly="True" FontFamily="Segoe UI" FontSize="18"
                   TextChanged="EditorTextBox_TextChanged" AutomationProperties.Name="Document text" />
          <ListBox x:Name="ReadingBlocksList" Visibility="Collapsed" BorderThickness="1"
                   BorderBrush="#CCC" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   SelectionMode="Single" SelectionChanged="ReadingBlocksList_SelectionChanged"
                   ItemTemplate="{StaticResource ReadingBlockTemplate}"
                   AutomationProperties.Name="Document text" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
          <Button x:Name="PreviousReadingPageButton" Content="Previous page"
                  Click="PreviousReadingPageButton_Click" IsEnabled="False" />
          <Button x:Name="NextReadingPageButton" Content="Next page"
                  Click="NextReadingPageButton_Click" IsEnabled="False" />
          <Button x:Name="EditSelectedBlockButton" Content="Edit selected block" Visibility="Collapsed"
                  Click="EditSelectedBlockButton_Click" IsEnabled="False" />
          <Button x:Name="BackToDocumentButton" Content="Back to document"
                  Click="BackToDocumentButton_Click" Visibility="Collapsed" />
          <CheckBox x:Name="FollowReadingCheckBox" Content="Follow reading" IsChecked="True"
                    VerticalAlignment="Center" Margin="6,0" />
          <Button x:Name="DuplicateEditableButton" Content="Duplicate as editable text"
                  Click="DuplicateEditableButton_Click" IsEnabled="False" />
          <Button x:Name="CreateRuleFromSelectionButton" Content="Create rule from selection"
                  Click="CreateRuleFromSelectionButton_Click"
                  AutomationProperties.Name="Create speech rule from selected text" />
          <Button x:Name="LibraryWorkflowButton" Content="Queue / bookmarks / WAV"
                  Click="LibraryWorkflowButton_Click" />
          <Button x:Name="FinishDocumentButton" Content="Mark finished"
                  Click="FinishDocumentButton_Click" IsEnabled="False" />
          <Button x:Name="ArchiveDocumentButton" Content="Archive"
                  Click="ArchiveDocumentButton_Click" IsEnabled="False" />
          <Button x:Name="RestoreDocumentButton" Content="Restore to inbox"
                  Click="RestoreDocumentButton_Click" IsEnabled="False" />
          <Button x:Name="SaveEditButton" Content="Save changes" Click="SaveEditButton_Click" IsEnabled="False" />
          <Button x:Name="RevertEditButton" Content="Revert changes" Click="RevertEditButton_Click" IsEnabled="False" />
          <Button x:Name="UndoButton" Content="Undo" Click="UndoButton_Click" IsEnabled="False" />
          <Button x:Name="RedoButton" Content="Redo" Click="RedoButton_Click" IsEnabled="False" />
        </StackPanel>
      </Grid>
    </Grid>

    <StatusBar Grid.Row="3">
      <StatusBarItem><TextBlock x:Name="FooterText" Text="Ready" /></StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
