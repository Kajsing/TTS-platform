<Window x:Class="TtsPlatform.Reader.App.RemoteAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote access" Height="700" Width="820" MinHeight="560" MinWidth="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Remote Reader" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Margin="0,4,0,12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                 Text="Local stays separate and remains the default offline workspace. Remote connects to another Reader library through HTTPS on a private network." />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="Connect this computer">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock TextWrapping="Wrap"
                     Text="Paste a ten-minute pairing invitation made on the server computer. The server identity is pinned before Reader sends the invitation secret." />
          <TextBox Grid.Row="1" x:Name="InvitationTextBox" Height="125" Margin="0,10,0,0"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   AutomationProperties.Name="Pairing invitation" />
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Workspace name" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="WorkspaceNameTextBox" Text="Home Reader" MaxLength="80" />
            <TextBlock Grid.Column="2" Text="This computer" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" x:Name="DeviceNameTextBox" MaxLength="80" />
            <Button Grid.Column="4" x:Name="PairButton" Content="Pair and save"
                    Style="{StaticResource PrimaryButtonStyle}" Click="PairButton_Click" />
          </Grid>
          <TextBlock Grid.Row="3" Margin="0,14,0,6" FontWeight="SemiBold"
                     Text="Saved remote workspaces" />
          <ListBox Grid.Row="4" x:Name="ProfilesList" DisplayMemberPath="Name"
                   AutomationProperties.Name="Saved remote workspaces" />
          <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="RotateCredentialButton" Content="Rotate credential"
                      Click="RotateCredentialButton_Click" />
              <Button x:Name="RemoveProfileButton" Content="Remove from this computer…"
                      Style="{StaticResource DangerButtonStyle}" Click="RemoveProfileButton_Click" />
            </StackPanel>
            <TextBlock Text="Credentials are protected for the current Windows user and are not stored in settings."
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Share this computer">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <Border Background="#FFF4D6" BorderBrush="#E4C36D" BorderThickness="1" CornerRadius="6" Padding="10">
              <TextBlock TextWrapping="Wrap"
                         Text="For internet access, connect both computers with owner-managed WireGuard first. Reader does not install or configure WireGuard. Never forward the Reader HTTPS port directly to the internet." />
            </Border>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Private address" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" x:Name="BindAddressTextBox" ToolTip="The exact WireGuard or private LAN address on this computer." />
              <TextBlock Grid.Column="2" Text="Port" Margin="12,0,0,0" VerticalAlignment="Center" />
              <TextBox Grid.Column="3" x:Name="PortTextBox" Text="7790" />
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Network" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" x:Name="FirewallModeComboBox" SelectionChanged="FirewallModeComboBox_SelectionChanged">
                <ComboBoxItem Content="WireGuard" Tag="wireguard" IsSelected="True" />
                <ComboBoxItem Content="Trusted LAN" Tag="lan" />
              </ComboBox>
              <TextBlock Grid.Column="2" Text="Peer IP/subnet" Margin="12,0,0,0" VerticalAlignment="Center" />
              <TextBox Grid.Column="3" x:Name="RemoteAddressTextBox" ToolTip="For example 10.7.0.2/32. LAN uses LocalSubnet." />
            </Grid>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Interface" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" x:Name="InterfaceAliasTextBox" ToolTip="The exact Windows WireGuard interface name." />
              <TextBlock Grid.Column="2" Text="Windows profile" Margin="12,0,0,0" VerticalAlignment="Center" />
              <ComboBox Grid.Column="3" x:Name="NetworkProfileComboBox">
                <ComboBoxItem Content="Private" />
                <ComboBoxItem Content="Public" IsSelected="True" />
                <ComboBoxItem Content="Domain" />
              </ComboBox>
            </Grid>
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="EnableServerButton" Content="Set up secure access…"
                      Style="{StaticResource PrimaryButtonStyle}" Click="EnableServerButton_Click" />
              <Button x:Name="RefreshServerButton" Content="Refresh status" Click="RefreshServerButton_Click" />
              <Button x:Name="DisableServerButton" Content="Disable and remove rule…"
                      Style="{StaticResource DangerButtonStyle}" Click="DisableServerButton_Click" />
            </WrapPanel>
            <TextBlock x:Name="ServerStatusText" Margin="3,5,0,0" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />

            <Separator Margin="0,14,0,10" />
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="CreateInvitationButton"
                      Content="Create 10-minute invitation" Click="CreateInvitationButton_Click" />
              <TextBlock Text="Pair another computer" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBox x:Name="ServerInvitationTextBox" Height="100" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            <Button x:Name="CopyInvitationButton" Content="Copy invitation" HorizontalAlignment="Left"
                    Click="CopyInvitationButton_Click" />

            <DockPanel Margin="0,14,0,6">
              <Button DockPanel.Dock="Right" x:Name="RevokeDeviceButton" Content="Revoke selected…"
                      Style="{StaticResource DangerButtonStyle}" Click="RevokeDeviceButton_Click" />
              <TextBlock Text="Paired computers" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="170">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Computer" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="Paired" Binding="{Binding CreatedAt}" Width="160" />
                <DataGridTextColumn Header="Last used" Binding="{Binding LastUsedAt}" Width="160" />
                <DataGridTextColumn Header="Revoked" Binding="{Binding RevokedAt}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Close" IsDefault="True" Click="CloseButton_Click" MinWidth="90" />
      <TextBlock x:Name="DialogStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
