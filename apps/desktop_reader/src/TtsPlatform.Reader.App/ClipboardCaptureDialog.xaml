<Window x:Class="TtsPlatform.Reader.App.ClipboardCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard capture" Width="620" Height="330" MinWidth="520" MinHeight="280"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ShowInTaskbar="False"
        AutomationProperties.Name="Clipboard capture actions">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="New clipboard text" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" x:Name="SourceText" Margin="0,4,0,10" Foreground="#555"
               TextWrapping="Wrap" />
    <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1" Padding="10">
      <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="15"
                 AutomationProperties.Name="Clipboard preview" />
    </Border>
    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
      <Button Content="Read now" Click="ReadNow_Click" />
      <Button Content="Append to open document" Click="Append_Click" />
      <Button Content="Create new document" Click="Create_Click" />
      <Button Content="Save to Inbox" Click="Inbox_Click" />
      <Button Content="Ignore" Click="Ignore_Click" />
      <Button x:Name="AlwaysIgnoreButton" Content="Always ignore this app"
              Click="AlwaysIgnore_Click" />
    </WrapPanel>
  </Grid>
</Window>
