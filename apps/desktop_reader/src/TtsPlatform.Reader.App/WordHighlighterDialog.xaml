<Window x:Class="TtsPlatform.Reader.App.WordHighlighterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word Highlighter" Width="720" Height="520" MinWidth="600" MinHeight="400"
        Icon="Assets/TtsPlatformReader.ico" WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip"
        AutomationProperties.Name="Global Word Highlighter">
  <Grid Background="{StaticResource AppBackgroundBrush}" Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Word Highlighter" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}"
                 Text="One global list for every article. Longer phrases take priority over shorter overlapping terms."
                 TextWrapping="Wrap" />
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,12,0,8">
      <Button DockPanel.Dock="Right" Content="Add" Click="Add_Click"
              Style="{StaticResource PrimaryButtonStyle}" />
      <TextBox x:Name="NewTermTextBox" MinWidth="320"
               ToolTip="Enter one word or phrase" AutomationProperties.Name="New highlighter term" />
    </DockPanel>
    <DataGrid Grid.Row="2" x:Name="TermsGrid" ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              SelectionMode="Single" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="On" Width="55" Binding="{Binding Active}" />
        <DataGridTemplateColumn Header="Color" Width="65" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Width="34" Height="20" CornerRadius="4" BorderBrush="#AAB4BE"
                      BorderThickness="1" Background="{Binding Color}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Word or phrase" Width="*" Binding="{Binding Term}" />
        <DataGridTextColumn Header="In article" Width="85" IsReadOnly="True" Binding="{Binding Count}" />
        <DataGridTemplateColumn Header="" Width="75" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Next" Padding="8,3" MinHeight="28" Click="Next_Click" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="3" x:Name="StatusText" Margin="3,8,3,0"
               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
    <DockPanel Grid.Row="4" Margin="0,9,0,0">
      <Button DockPanel.Dock="Left" Content="Remove selected" Click="Remove_Click"
              Style="{StaticResource DangerButtonStyle}" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Cancel" Click="Cancel_Click" />
        <Button Content="Save" Click="Save_Click" IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
