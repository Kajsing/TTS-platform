<Window x:Class="TtsPlatform.Reader.App.RecoveryKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save recovery key" Height="330" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Save this recovery key now" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap"
               Text="Reader will not show this key again. It can reset the folder code if you forget it. A reset creates a new recovery key." />
    <TextBox Grid.Row="2" x:Name="RecoveryKeyTextBox" IsReadOnly="True"
             FontFamily="Consolas" FontSize="16" Padding="8"
             AutomationProperties.Name="One-time recovery key" />
    <Button Grid.Row="3" Content="Copy key" Click="CopyButton_Click"
            HorizontalAlignment="Left" Margin="0,10,0,0" />
    <CheckBox Grid.Row="4" x:Name="SavedCheckBox" Margin="0,16,0,0"
              Content="I saved the recovery key" Checked="SavedCheckBox_Changed"
              Unchecked="SavedCheckBox_Changed" />
    <Button Grid.Row="5" x:Name="CloseButton" Content="Done" MinWidth="90"
            HorizontalAlignment="Right" IsDefault="True" IsEnabled="False"
            Click="CloseButton_Click" />
  </Grid>
</Window>
