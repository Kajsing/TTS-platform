<Window x:Class="TtsPlatform.Reader.App.BatchImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import several articles" Height="570" Width="860" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Import several articles" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="SummaryText" Margin="0,4,0,12" Foreground="#555" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Destination" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Grid.Column="1" x:Name="DestinationComboBox" DisplayMemberPath="Name"
                AutomationProperties.Name="Import destination folder" />
      <CheckBox Grid.Column="2" x:Name="AllowDuplicateCheckBox"
                Content="Allow duplicate content" Margin="14,0,0,0" VerticalAlignment="Center" />
      <CheckBox Grid.Column="3" x:Name="KeepSourceCheckBox"
                Content="Keep source copies" Margin="14,0,0,0" VerticalAlignment="Center" />
    </Grid>
    <DataGrid Grid.Row="2" x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True"
              EnableRowVirtualization="True" AutomationProperties.Name="Batch import files">
      <DataGrid.Columns>
        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
        <DataGridTextColumn Header="Warnings / result" Binding="{Binding Message}" Width="3*" />
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="3" Background="#FFF4D6" Padding="10" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Text="Ready to preview and import."
                 TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <DockPanel Grid.Row="4" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="Close" Click="CloseButton_Click"
              MinWidth="90" />
      <Button DockPanel.Dock="Right" x:Name="StartButton" Content="Preview and import"
              Click="StartButton_Click" MinWidth="140" />
      <Button DockPanel.Dock="Right" x:Name="CancelRemainingButton" Content="Cancel remaining"
              Click="CancelRemainingButton_Click" MinWidth="120" IsEnabled="False" />
      <ProgressBar x:Name="Progress" Height="10" Minimum="0" VerticalAlignment="Center" />
    </DockPanel>
  </Grid>
</Window>
