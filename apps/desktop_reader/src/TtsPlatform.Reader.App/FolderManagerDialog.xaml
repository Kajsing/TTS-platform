<Window x:Class="TtsPlatform.Reader.App.FolderManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Article folders" Height="500" Width="620" MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Article folders" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Margin="0,4,0,12" Foreground="#555" TextWrapping="Wrap"
                 Text="Folders organize articles inside Reader. All articles is the implicit root and cannot be deleted." />
    </StackPanel>
    <DataGrid Grid.Row="1" x:Name="FolderGrid" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" SelectionChanged="FolderGrid_SelectionChanged"
              AutomationProperties.Name="Article folders">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Folder" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Articles" Binding="{Binding ArticleCount}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="FolderNameTextBox" MaxLength="200"
               AutomationProperties.Name="Folder name" />
      <Button Grid.Column="1" Content="Create" Click="CreateButton_Click" Margin="8,0,0,0" />
      <Button Grid.Column="2" x:Name="RenameButton" Content="Rename" Click="RenameButton_Click"
              Margin="8,0,0,0" IsEnabled="False" />
      <Button Grid.Column="3" x:Name="DeleteButton" Content="Delete…" Click="DeleteButton_Click"
              Margin="8,0,0,0" IsEnabled="False" />
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Close" IsDefault="True" Click="CloseButton_Click"
              MinWidth="90" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
