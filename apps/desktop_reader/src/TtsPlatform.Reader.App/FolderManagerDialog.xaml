<Window x:Class="TtsPlatform.Reader.App.FolderManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Article folders" Height="530" Width="620" MinHeight="430" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Article folders" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Margin="0,4,0,12" Foreground="#555" TextWrapping="Wrap"
                 Text="Folders organize articles inside Reader. All articles is the implicit root and cannot be deleted." />
      <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"
                 Text="Open shows or hides a folder's articles in this Reader's library. It does not change Privacy locks or agent access." />
    </StackPanel>
    <DataGrid Grid.Row="1" x:Name="FolderGrid" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" SelectionChanged="FolderGrid_SelectionChanged"
              AutomationProperties.Name="Article folders">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Folder" Binding="{Binding Name, Mode=OneWay}" Width="*" />
        <DataGridTextColumn Header="Articles" Binding="{Binding ArticleCount, Mode=OneWay}" Width="90" />
        <DataGridCheckBoxColumn Header="Locked" Binding="{Binding PrivacyLocked, Mode=OneWay}" Width="70" />
        <DataGridTemplateColumn Header="Open" Width="65">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsOpen, Mode=OneWay}" Tag="{Binding}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"
                        AutomationProperties.Name="Show folder articles"
                        ToolTip="Show or hide this folder's articles. Saved on this computer."
                        Checked="OpenFolderCheckBox_Changed" Unchecked="OpenFolderCheckBox_Changed" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="FolderNameTextBox" MaxLength="200"
               AutomationProperties.Name="Folder name" />
      <Button Grid.Column="1" Content="Create" Click="CreateButton_Click" Margin="8,0,0,0" />
      <Button Grid.Column="2" x:Name="RenameButton" Content="Rename" Click="RenameButton_Click"
              Margin="8,0,0,0" IsEnabled="False" />
      <Button Grid.Column="3" x:Name="DeleteButton" Content="Delete…" Click="DeleteButton_Click"
              Margin="8,0,0,0" IsEnabled="False" />
    </Grid>
    <WrapPanel Grid.Row="3" Margin="0,10,0,0">
      <Button x:Name="SetPrivacyButton" Content="Set Privacy lock…"
              Click="SetPrivacyButton_Click" IsEnabled="False" />
      <Button x:Name="UnlockButton" Content="Unlock…" Margin="8,0,0,0"
              Click="UnlockButton_Click" IsEnabled="False" />
      <Button x:Name="RelockButton" Content="Relock" Margin="8,0,0,0"
              Click="RelockButton_Click" IsEnabled="False" />
      <Button x:Name="ChangeCodeButton" Content="Change code…" Margin="8,0,0,0"
              Click="ChangeCodeButton_Click" IsEnabled="False" />
      <Button x:Name="RecoverButton" Content="Recover…" Margin="8,0,0,0"
              Click="RecoverButton_Click" IsEnabled="False" />
      <Button x:Name="RemovePrivacyButton" Content="Remove lock…" Margin="8,0,0,0"
              Click="RemovePrivacyButton_Click" IsEnabled="False" />
    </WrapPanel>
    <DockPanel Grid.Row="4" Margin="0,12,0,0">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" IsDefault="True" Click="CloseButton_Click"
              MinWidth="90" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
