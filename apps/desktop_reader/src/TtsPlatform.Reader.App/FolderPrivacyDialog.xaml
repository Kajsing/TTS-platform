<Window x:Class="TtsPlatform.Reader.App.FolderPrivacyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="390" Width="520" MinHeight="330" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold" />
    <Border Grid.Row="1" Margin="0,10,0,12" Padding="10" CornerRadius="5"
            Background="#FFF4CE" BorderBrush="#E0B400" BorderThickness="1">
      <TextBlock TextWrapping="Wrap"
                 Text="Privacy lock hides this folder inside Reader. It does not encrypt the database, files, or backups." />
    </Border>
    <StackPanel Grid.Row="2" x:Name="PrimaryPanel">
      <TextBlock x:Name="PrimaryLabel" Margin="0,0,0,4" />
      <PasswordBox x:Name="PrimaryPasswordBox" MaxLength="128"
                   AutomationProperties.Name="Privacy credential" />
    </StackPanel>
    <StackPanel Grid.Row="3" x:Name="NewCodePanel" Margin="0,12,0,0">
      <StackPanel x:Name="NewCodeEntryPanel">
        <TextBlock Text="New code (at least 6 characters)" Margin="0,0,0,4" />
        <PasswordBox x:Name="NewCodePasswordBox" MaxLength="128"
                     AutomationProperties.Name="New privacy code" />
      </StackPanel>
      <TextBlock Text="Confirm new code" Margin="0,10,0,4" />
      <PasswordBox x:Name="ConfirmPasswordBox" MaxLength="128"
                   AutomationProperties.Name="Confirm new privacy code" />
    </StackPanel>
    <TextBlock Grid.Row="4" x:Name="ValidationText" Margin="0,10,0,0"
               Foreground="#A4262C" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" MinWidth="90" IsCancel="True" />
      <Button x:Name="AcceptButton" Content="Continue" MinWidth="100" Margin="8,0,0,0"
              IsDefault="True" Click="AcceptButton_Click" />
    </StackPanel>
  </Grid>
</Window>
