{
  "contract_version": 1,
  "enabled": true,
  "database": {
    "ready": true,
    "schema_version": 9,
    "search_available": true
  },
  "imports": {
    "formats": ["txt", "md", "html", "docx", "epub"],
    "max_file_bytes": 52428800,
    "ocr_available": false
  },
  "rules": {
    "types": [
      "literal_replace",
      "regex_replace",
      "skip",
      "spell",
      "pause",
      "phoneme"
    ],
    "regex_timeout_supported": true
  },
  "playback": {
    "stream_protocol_version": 1,
    "source_offset_encoding": "utf-16",
    "max_blocks_per_window": 64,
    "max_source_chars_per_window": 32000
  },
  "exports": {
    "formats": ["wav", "mp3"]
  },
  "browser_capture": {
    "available": true,
    "max_characters": 10000000,
    "desktop_handoff": true
  },
  "block_pages": {
    "max_response_bytes": 2097152,
    "max_block_characters": 1000000,
    "whole_blocks_only": true
  },
  "source_search": {
    "available": true,
    "positions_only": true,
    "max_source_utf16": 32000000,
    "max_source_blocks": 100000,
    "max_request_bytes": 16384,
    "max_response_bytes": 1048576,
    "max_find_matches": 10000,
    "max_highlighter_matches": 250000,
    "max_window_matches": 2000,
    "max_sessions": 4,
    "session_idle_seconds": 300,
    "regex_provider": "regex-v0"
  }
}
